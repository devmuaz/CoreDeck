# =============================================================================
# .clang-tidy — tests/
# -----------------------------------------------------------------------------
# Inherits the project root .clang-tidy and disables checks that fire on
# Catch2's macro-generated code (where we can't change the expansion):
#
#   misc-use-anonymous-namespace
#     TEST_CASE / SCENARIO / TEMPLATE_TEST_CASE expand to functions declared
#     `static` (e.g. CATCH2_INTERNAL_TEST_0). The check wants those in an
#     anonymous namespace, but the choice is Catch2's.
#
#   cert-err58-cpp
#     Catch2 registers tests via static initializers that can throw; this
#     check flags every TEST_CASE.
#
#   cppcoreguidelines-avoid-non-const-global-variables
#     Catch2's auto-registered TestInvoker objects are non-const file-scope
#     globals by design.
#
#   readability-function-cognitive-complexity / readability-function-size
#     Tests are often long, flat sequences of REQUIRE/CHECK assertions and
#     trip the complexity / line-count thresholds without any real benefit.
#
#   cppcoreguidelines-avoid-do-while
#     REQUIRE / CHECK / REQUIRE_THROWS / etc. expand to
#     `do { ... } while((void)0, false)` -- the standard idiom for a
#     multi-statement macro that behaves like a single statement.
#
# Naming-convention exemptions are below the Checks list.
# =============================================================================

InheritParentConfig: true

Checks: >
  -misc-use-anonymous-namespace,
  -cert-err58-cpp,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-avoid-do-while,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -readability-identifier-naming

WarningsAsErrors: ""
