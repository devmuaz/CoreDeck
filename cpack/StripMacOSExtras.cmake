if(NOT DEFINED CPACK_TEMPORARY_DIRECTORY OR CPACK_TEMPORARY_DIRECTORY STREQUAL "" OR CPACK_TEMPORARY_DIRECTORY STREQUAL "/")
    message(FATAL_ERROR "CPACK_TEMPORARY_DIRECTORY is not set; refusing to build the disk image.")
endif()

message(STATUS "CoreDeck disk image root: ${CPACK_TEMPORARY_DIRECTORY}")
foreach(_dir bin include lib lib64 share)
    if(EXISTS "${CPACK_TEMPORARY_DIRECTORY}/${_dir}")
        message(STATUS "Removing ${_dir} from the disk image")
        file(REMOVE_RECURSE "${CPACK_TEMPORARY_DIRECTORY}/${_dir}")
    endif()
    if(EXISTS "${CPACK_TEMPORARY_DIRECTORY}/${_dir}")
        message(FATAL_ERROR "Could not remove ${CPACK_TEMPORARY_DIRECTORY}/${_dir} from the disk image.")
    endif()
endforeach()
