#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:140
msgid "Screen Mode"
msgstr "Mode d'écran"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:141
msgid "Set emulated screen mode"
msgstr "Définit le mode d'écran émulé"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:148
msgid "Device DPI"
msgstr "DPI de l'appareil"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:149
msgid "Override the device's screen density in dpi"
msgstr "Remplace la densité d'écran de l'appareil, en dpi"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:152
msgid "e.g., 420"
msgstr "p. ex. 420"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:156
#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/gui/home/avd_details_panel.cpp:216
#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/gui/home/create_avd_dialog.cpp:212
msgid "Skin"
msgstr "Habillage"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:157
msgid "Select a specific device skin by name"
msgstr "Sélectionne un habillage d'appareil par son nom"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:160
msgid "e.g., pixel_7"
msgstr "p. ex. pixel_7"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:164
msgid "Disable Skin"
msgstr "Désactiver l'habillage"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:165
msgid "Run without any device skin"
msgstr "S'exécute sans habillage d'appareil"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:171
msgid "Window Size"
msgstr "Taille de la fenêtre"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:172
msgid "Set the initial emulator window size (useful with no-skin)"
msgstr ""
"Définit la taille initiale de la fenêtre de l'émulateur (utile sans "
"habillage)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:175
msgid "e.g., 1080x1920"
msgstr "p. ex. 1080x1920"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:184
msgid "Physical RAM (MBs)"
msgstr "RAM physique (Mo)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:185
msgid "Physical RAM size in MBs"
msgstr "Quantité de RAM physique, en Mo"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:188
#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:487
msgid "e.g., 2048"
msgstr "p. ex. 2048"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:192
msgid "CPU Cores"
msgstr "Cœurs du processeur"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:193
msgid "Set number of CPU cores for the emulator"
msgstr "Définit le nombre de cœurs du processeur pour l'émulateur"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:196
msgid "e.g., 4"
msgstr "p. ex. 4"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:200
msgid "Cache Size (MBs)"
msgstr "Taille du cache (Mo)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:201
msgid "Cache partition size in MBs"
msgstr "Taille de la partition de cache, en Mo"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:204
msgid "e.g., 512"
msgstr "p. ex. 512"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:213
msgid "Full Boot"
msgstr "Démarrage complet"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:214
msgid "Perform a full boot and do not auto-save on exit"
msgstr ""
"Effectue un démarrage complet et n'enregistre pas automatiquement à la "
"fermeture"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:220
msgid "Cold Boot"
msgstr "Démarrage à froid"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:221
msgid "Perform a full boot without loading a snapshot (preserves user data)"
msgstr ""
"Effectue un démarrage complet sans charger d'instantané (conserve les "
"données utilisateur)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:227
msgid "Discard State on Exit"
msgstr "Abandonner l'état à la fermeture"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:228
msgid "Do not auto-save to snapshot on exit; changed state is abandoned"
msgstr ""
"N'enregistre pas d'instantané à la fermeture ; l'état modifié est abandonné"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:234
msgid "Snapshot Name"
msgstr "Nom de l'instantané"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:235
msgid "Name of the snapshot to auto-start from and auto-save to"
msgstr ""
"Nom de l'instantané utilisé pour le démarrage et l'enregistrement "
"automatiques"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:238
msgid "e.g., default-boot"
msgstr "p. ex. default-boot"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:242
msgid "Read-Only (Multi-Instance)"
msgstr "Lecture seule (instances multiples)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:243
msgid ""
"Allow running multiple instances of this AVD (snapshots cannot be saved)"
msgstr ""
"Autorise plusieurs instances de cet AVD (les instantanés ne peuvent pas être "
"enregistrés)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:249
msgid "Factory Reset"
msgstr "Réinitialisation d'usine"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:250
msgid "Reset AVD to factory defaults (clears user data)"
msgstr ""
"Réinitialise l'AVD aux valeurs d'usine (efface les données utilisateur)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:256
msgid "Skip Boot Animation"
msgstr "Ignorer l'animation de démarrage"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:257
msgid "Disable boot animation for faster startup"
msgstr "Désactive l'animation de démarrage pour un lancement plus rapide"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:268
msgid "Disable Audio"
msgstr "Désactiver l'audio"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:269
msgid "Disable audio support"
msgstr "Désactive la prise en charge de l'audio"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:275
msgid "Allow Host Microphone"
msgstr "Autoriser le microphone de l'hôte"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:276
msgid "Pass host audio input devices through to the guest (otherwise zeroed)"
msgstr ""
"Transmet les périphériques d'entrée audio de l'hôte à l'invité (sinon ils "
"sont mis à zéro)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:287
msgid "Network Speed"
msgstr "Vitesse du réseau"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:288
msgid "Simulate network download/upload speed"
msgstr "Simule la vitesse de téléchargement et d'envoi du réseau"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:295
msgid "Network Delay"
msgstr "Délai réseau"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:296
msgid "Simulate network latency"
msgstr "Simule la latence du réseau"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:303
msgid "HTTP Proxy"
msgstr "Proxy HTTP"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:304
msgid ""
"Route network traffic through a HTTP/HTTPS proxy (e.g., Charles, mitmproxy)"
msgstr ""
"Achemine le trafic réseau via un proxy HTTP/HTTPS (p. ex. Charles, mitmproxy)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:307
msgid "e.g., http://localhost:8888"
msgstr "p. ex. http://localhost:8888"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:311
msgid "DNS Server"
msgstr "Serveur DNS"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:312
msgid "Use custom DNS server(s) in the emulated system"
msgstr ""
"Utilise un ou plusieurs serveurs DNS personnalisés dans le système émulé"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:315
msgid "e.g., 8.8.8.8"
msgstr "p. ex. 8.8.8.8"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:319
msgid "Packet Capture File"
msgstr "Fichier de capture de paquets"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:320
msgid "Capture network packets to the given pcap file"
msgstr "Capture les paquets réseau dans le fichier pcap indiqué"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:323
msgid "e.g., /tmp/emulator.pcap"
msgstr "p. ex. /tmp/emulator.pcap"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:327
msgid "Console Port"
msgstr "Port de la console"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:328
msgid "TCP port used for the emulator console (adb port is console + 1)"
msgstr ""
"Port TCP de la console de l'émulateur (le port adb est celui de la console + "
"1)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:331
msgid "e.g., 5554"
msgstr "p. ex. 5554"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:335
msgid "Console + ADB Ports"
msgstr "Ports console et adb"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:336
msgid "TCP ports used for the console and adb bridge"
msgstr "Ports TCP de la console et du pont adb"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:339
msgid "e.g., 5554,5555"
msgstr "p. ex. 5554,5555"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:348
msgid "Back Camera"
msgstr "Caméra arrière"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:349
msgid "Set emulation mode for the back-facing camera"
msgstr "Définit le mode d'émulation de la caméra arrière"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:356
msgid "Front Camera"
msgstr "Caméra avant"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:357
msgid "Set emulation mode for the front-facing camera"
msgstr "Définit le mode d'émulation de la caméra avant"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:369
msgid "Disable Passive GPS"
msgstr "Désactiver le GPS passif"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:370
msgid "Disable passive GPS updates from the host"
msgstr "Désactive les mises à jour GPS passives provenant de l'hôte"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:376
msgid "GNSS Replay File"
msgstr "Fichier de relecture GNSS"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:377
msgid "Read GNSS data from the given file to replay a route"
msgstr "Lit les données GNSS du fichier indiqué pour rejouer un parcours"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:380
msgid "e.g., /path/to/track.nmea"
msgstr "p. ex. /path/to/track.nmea"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:389
msgid "Phone Number"
msgstr "Numéro de téléphone"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:390
msgid "Set the phone number reported by the emulated device"
msgstr "Définit le numéro de téléphone annoncé par l'appareil émulé"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:393
msgid "e.g., +15555550100"
msgstr "p. ex. +15555550100"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:397
msgid "Locale"
msgstr "Paramètres régionaux"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:398
msgid "Override the device locale (restarts the framework)"
msgstr ""
"Remplace les paramètres régionaux de l'appareil (redémarre le framework)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:401
msgid "e.g., en-US"
msgstr "p. ex. en-US"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:405
msgid "Writable System"
msgstr "Système inscriptible"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:406
msgid "Make the system and vendor images writable after 'adb remount'"
msgstr "Rend les images system et vendor inscriptibles après « adb remount »"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:412
msgid "Skip ADB Auth"
msgstr "Ignorer l'authentification adb"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:413
msgid "Skip the adb authentication dialog on connect"
msgstr "Ignore la boîte de dialogue d'authentification adb à la connexion"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:419
msgid "Instance ID"
msgstr "Identifiant d'instance"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:420
msgid ""
"Assign a separate id to this virtual device (independent of the AVD name)"
msgstr ""
"Attribue un identifiant distinct à cet appareil virtuel (indépendant du nom "
"de l'AVD)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:423
msgid "e.g., my-instance-1"
msgstr "p. ex. my-instance-1"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:427
msgid "System Property"
msgstr "Propriété système"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:428
msgid "Set a system property on boot (single name=value pair)"
msgstr ""
"Définit une propriété système au démarrage (une seule paire nom=valeur)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:431
msgid "e.g., ro.debuggable=1"
msgstr "p. ex. ro.debuggable=1"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:435
msgid "Emulator Features"
msgstr "Fonctions de l'émulateur"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:436
msgid "Force-enable or disable (-name) emulator features"
msgstr ""
"Force l'activation ou la désactivation (-name) de fonctions de l'émulateur"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:439
msgid "e.g., GLESDynamicVersion,-Vulkan"
msgstr "p. ex. GLESDynamicVersion,-Vulkan"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:448
msgid "Headless Mode"
msgstr "Mode sans fenêtre"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:449
msgid "Run without graphical window display (useful for CI/testing)"
msgstr ""
"S'exécute sans fenêtre graphique (utile pour l'intégration continue et les "
"tests)"

#: /Users/devmuaz/Development/projects/cpp-projects/CoreDeck/src/core/avd/emulator_options.cpp:455
