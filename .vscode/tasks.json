{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake-build-coredeck-debug",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/.vscode/scripts/cmake-build.sh\" Debug CoreDeck",
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "windows": {
        "options": {
          "shell": {
            "executable": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
          }
        },
        "command": "& \"${workspaceFolder}/.vscode/scripts/cmake-build.ps1\" -BuildType Debug -Target CoreDeck",
        "problemMatcher": ["$msCompile"]
      }
    },
    {
